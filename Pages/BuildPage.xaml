<Page x:Class="pr5_Shitov_WPF.Pages.BuildPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сборка">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Label Content="ID"/>
            <Label Content="Название"/>
            <Label Content="Назначение"/>
            <Label Content="Владелец"/>
            <Label Content="Стоимость сборки"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBox Margin="5" Text="{Binding Id}" IsReadOnly="True"/>
            <TextBox Margin="5" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="5" Text="{Binding BuildTotal, StringFormat={}{0:F2}}"
                       FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Column="2" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView ItemsSource="{Binding Components}"
                      SelectedItem="{Binding SelectedComponent, RelativeSource={RelativeSource AncestorType=Page}}"
                      >
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Название" Width="140"
                                        DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Тип" Width="100"
                                        DisplayMemberBinding="{Binding Type}"/>
                        <GridViewColumn Header="Цена" Width="100"
                                        DisplayMemberBinding="{Binding Price, StringFormat={}{0:F2}}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <Button Content="Добавить компонент" Margin="5" Padding="8,4" Click="Button_Add"
                        />
                <Button Content="Редактировать" Margin="5" Padding="8,4" Click="Button_Edit"
                        />
                <Button Content="Удалить компонент" Margin="5" Padding="8,4" Click="Button_Delete"
                        />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Content="Сохранить" Margin="5" Padding="15,6" Click="Button_Save"
                        />
                <Button Content="Назад" Margin="5" Padding="15,6" Click="Button_Back"
                        />
            </StackPanel>
        </Grid>
    </Grid>
</Page>