<Page x:Class="pr5_Shitov_WPF.Pages.ComponentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr5_Shitov_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="ComponentPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="135"/>
            <ColumnDefinition Width="140"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Добавление компонента" Margin="15" FontSize="19" Grid.ColumnSpan="2"/>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="8, 0, 0, 0">
            <TextBlock Text="Название компонента: " Margin="0, 3"/>
            <TextBlock Text="Тип: " Margin="0, 3"/>
            <TextBlock Text="Цена: " Margin="0, 3"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10, 0, 0, 0">
            <TextBox Margin="0, 2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="0, 2" Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="0, 2" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <WrapPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="10">
            <Button Content="Сохранить" Width="70" Margin="0, 0, 10, 0" Click="Button_Click_1"/>
            <Button Content="Назад" Width="60" Click="Button_Click"/>
        </WrapPanel>
    </Grid>
</Page>
